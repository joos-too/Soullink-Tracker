{
  "name": "soullink-tracker",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "generate-pokemon": "node scripts/generate-pokemon.mjs",
    "generate-items": "node scripts/generate-items.mjs",
    "migrate-pokemon-ids": "node scripts/migrate-pokemon-names-to-ids.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "supabase:migration:new": "supabase migration new",
    "supabase:db:push": "supabase db push",
    "supabase:db:push:dry-run": "supabase db push --dry-run",
    "supabase:staging:preflight": "node scripts/staging-rehearsal-preflight.mjs",
    "firebase:auth:migrate": "tsx scripts/migrate-firebase-auth-to-supabase.ts",
    "firebase:migrate": "tsx scripts/migrate-firebase-to-supabase.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:bundle": "npm run build && node scripts/check-bundle.mjs && playwright test --config playwright.bundle.config.ts",
    "test:migration": "vitest run scripts/firebase-migration",
    "test:migration:integration": "node scripts/run-migrated-data-integration.mjs",
    "typecheck:migration": "tsc --project tsconfig.migration.json",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/run-supabase-e2e.mjs",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.2.4",
    "i18next": "26.3.4",
    "pokeapi-js-wrapper": "^1.2.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.6.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pg": "^8.22.0",
    "pokedex-promise-v2": "^4.2.1",
    "prettier": "3.6.2",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
