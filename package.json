{
  "name": "soullink-tracker",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "generate-pokemon": "node scripts/pokeapi/generate-pokemon.mjs",
    "generate-items": "node scripts/pokeapi/generate-items.mjs",
    "migrate-pokemon-ids": "node scripts/migrate-pokemon-names-to-ids.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "node scripts/supabase/generate-supabase-types.mjs",
    "supabase:migration:new": "supabase migration new",
    "supabase:db:push": "supabase db push",
    "supabase:db:push:dry-run": "supabase db push --dry-run",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:bundle": "npm run build && node scripts/check-bundle.mjs && playwright test --config tests/bundle/playwright.config.ts",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/supabase/run-supabase-e2e.mjs",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "i18next": "27.2.2",
    "pokeapi-js-wrapper": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.6",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "pg": "^8.23.1",
    "pokedex-promise-v2": "^4.2.3",
    "prettier": "3.10.1",
    "supabase": "^3.2.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
